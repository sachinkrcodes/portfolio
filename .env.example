# Copy this file to .env.local for local testing. On Vercel add the same names under
# Project Settings > Environment Variables. Never commit real values (.env*.local is already ignored).

# Your site address, for link previews and structured data (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# ---- Contact form: pick ONE provider -------------------------------------------------------------
# Option 1 (recommended): Resend (resend.com, free plan). Create an API key, paste it here.
RESEND_API_KEY=
# Where messages are delivered. Defaults to the email in src/data/content.ts.
# With the default sender below, Resend only delivers to the email you signed up to Resend with.
CONTACT_TO_EMAIL=
# Optional: your own verified sender, for example "Portfolio <hello@yourdomain.com>"
CONTACT_FROM=

# Option 2: Formspree (formspree.io, free plan). Create a form and paste its id (the part after /f/).
FORMSPREE_ID=
